FARCASTER_MCP_URL=http://sidelineiq-mcp-servers.railway.internal:3101/mcp
TWITTER_MCP_URL=http://sidelineiq-mcp-servers.railway.internal:3102/mcp
WEB_MCP_URL=https://sidelineiq-mcp-servers-production.up.railway.app/mcp
# Sent as `Authorization: Bearer <secret>` on every MCP request to the
# farcaster/twitter/web servers above. Must match MCP_AUTH_SECRET set in the
# sidelineiq-mcp-servers deployment(s). Servers fail closed (503) without it.
MCP_AUTH_SECRET=
PORT=3100
# Production runs 0.70. The code default is 0.75 (publishing-pipeline.ts), and
# an out-of-range value falls back to that default with a warning rather than
# silently disabling the gate. Do not restate this number in the agent prompt —
# it has drifted four ways already.
MD_REVIEW_CONFIDENCE_THRESHOLD=0.70
# Fact-validator soft codes that should ANNOTATE rather than force MD review.
# Comma-separated; empty (the default) means every soft code forces review, as
# it always has. This lever exists because a soft failure becomes
# forceMDReviewReason, which bypasses needsMDReview entirely — so without it no
# threshold or confidence change can un-gate a post a soft code has touched.
# Downgraded codes are still logged and written to the validation audit row.
# Codes: identity_unresolvable, identity_ambiguous, team_unverifiable,
# team_unverified, team_mismatch_unconfirmed, laterality_inconsistent,
# procedure_body_part_mismatch, source_tier_low.
MD_REVIEW_ANNOTATE_ONLY_CODES=
ORTHOIQ_REFERRAL_URL=https://orthoiq.com?ref=sidelineiq

# Anthropic API key for classifier + agent Claude calls
ANTHROPIC_API_KEY=

# Shared secret for the /admin/* endpoints (approve, promote, roster-sync).
# Server-to-server only: the frontend forwards this as `Authorization: Bearer <secret>`
# on its admin route handlers. Must match AGENTS_API_SECRET set in the frontend (Vercel).
# Fail-closed — if unset, /admin/* returns 503.
AGENTS_API_SECRET=

# Autonomous polling loop configuration
# Set POLLING_ENABLED=false to disable the loop (e.g. for local dev or migrations)
POLLING_ENABLED=true
# Poll cadence in milliseconds (default: 15 minutes)
POLL_INTERVAL_MS=900000
# Per-sport toggles — launch order is NFL first, others opt-in as they stabilize
POLL_NFL=true
POLL_NBA=false
POLL_PREMIER_LEAGUE=false
POLL_UFC=false
# Max age of injury events to process (days). Filters out IR/stale listings.
# Tighten during active season (e.g. 2), relax during offseason (default: 7)
MAX_EVENT_AGE_DAYS=7
# Publish volume caps. The significance gate decides WHAT is worth covering;
# these bound HOW MUCH lands per cycle/day. Capped events are not lost — the
# source re-serves them next cycle. Tune without redeploying.
# Per sport, per cycle (default: 3)
MAX_PUBLISHES_PER_CYCLE=3
# MD review is a SEPARATE lane. It used to share the publish counter, so with
# MAX_PUBLISHES_PER_CYCLE=1 the first event routed to review spent the cycle's
# only slot and nothing ever published. Both default to the publish cap, so
# splitting them cannot change total volume by more than a factor of two.
MAX_REVIEWS_PER_CYCLE=3
MAX_REVIEWS_PER_DAY=10
# Per sport, per cycle — bounds Sonnet spend, checked before the agent runs (default: 8)
MAX_AGENT_CALLS_PER_CYCLE=8
# Global rolling 24h cap across all sports (default: 10). Fails open if the
# web MCP server can't be reached; the per-cycle caps still apply.
MAX_PUBLISHES_PER_DAY=10
# Injury Thread Manager: pre-OTM date-resolution loop (native web_search fallback).
# Opt-in (default off) — set to 'true' once validated. Adds up to two Claude calls
# per unresolved event before OTM. Requires the mcp web server (migration 014) live.
DATE_RESOLUTION_ENABLED=false

# Athlete re-anchor: when the classifier names a different athlete than the
# source tagged, follow the classifier if — and only if — the roster confirms a
# different, unambiguous player whom the source text actually names, AND the
# source's own data says the tagged athlete is not the injured one (an ESPN
# injuries row with status "Active" is carrying a teammate's news).
#   off    — never; the drift always forces MD review.
#   shadow — decide and log ([Reanchor] shadow …), change nothing. DEFAULT.
#   on     — apply it: the event is re-pointed before fact validation, dedup and
#            entity creation read an identity off it, and significance is
#            re-scored on the correct athlete's tier.
# Ship on shadow, read a few cycles of logs, then flip to on.
ATHLETE_REANCHOR_MODE=shadow

# ApprovalSync: safety net that re-publishes approved posts which are PUBLISHED
# on the web but carry no social hash (5-min cycle).
# Its duplicate guard is in-memory and resets on deploy, so a backlog built up
# while publishing was broken would be re-cast wholesale on the next deploy.
# Set this ISO cutoff to hold a backlog back and decide the backfill yourself;
# posts created before it are never auto-republished. Unset = no cutoff.
APPROVAL_SYNC_NOT_BEFORE=

# Which content types ApprovalSync may re-cast. Comma-separated; unset or blank
# means DEEP_DIVE only, which is the behaviour that shipped.
# It exists because the Aug 2026 outage orphaned 6 BREAKING and 3 CONFLICT_FLAG
# posts and not one DEEP_DIVE — the safety net could not have recovered any of
# the failure it was built for. Widening is real risk, so it is opt-in.
# Age budgets differ per type and are enforced in code regardless of the cutoff:
# BREAKING 6h, TRACKING 48h, CONFLICT_FLAG 7d, DEEP_DIVE 7d. This loop recovers
# a publish that failed minutes-to-hours ago; anything older is an editorial
# call and belongs to src/scripts/republish-social-orphans.ts, not a cron.
# At most 2 posts per cycle, 45s apart — a backlog drips, it does not flood.
APPROVAL_SYNC_CONTENT_TYPES=

# NewsAPI (secondary NFL source for cross-validation with ESPN).
# Free tier: 100 req/day. Default N=6 → ~16 req/day for NFL, leaving headroom
# for future sports. Hard floor of N=4 enforced in code (max 24 req/day).
NEWSAPI_KEY=
NEWSAPI_POLL_EVERY_N_CYCLES=6

# X (Twitter) insider source — curated allowlist of sports-insider timelines,
# read via X's own official MCP server (not the sidelineiq-mcp-servers gateway
# used by TWITTER_MCP_URL above). Read-only. See src/config/x-insiders.ts.
X_API_MCP_URL=https://api.x.com/mcp
# X's own app-only bearer token (read-only scope) — distinct from
# MCP_AUTH_SECRET, which authenticates only to sidelineiq's own gateway servers.
X_API_MCP_BEARER_TOKEN=
# Kill switch — disable X insider polling without a redeploy.
X_INSIDER_SOURCE_ENABLED=true
# Force every X-sourced event to MD review regardless of classifier confidence
# (defense against insider-account impersonation, which text-quality scoring
# alone would not catch). Leave true; only disable once trust in the source
# is well established.
X_INSIDER_FORCE_MD_REVIEW=true
# Max tweets fetched per insider per poll cycle.
X_INSIDER_MAX_RESULTS_PER_USER=5
# Poll every Nth cycle (default 1 = every 15-minute cycle).
X_INSIDER_POLL_EVERY_N_CYCLES=1
# Overrides the X MCP tool name used for timeline lookups — confirm the real
# name against the live server's tools/list before go-live; X's tool names
# are auto-generated from their OpenAPI spec and not fully documented.
X_API_TIMELINE_TOOL_NAME=getUsersIdTweets

# Return Watch — minimum days a desk_post must have been PUBLISHED before new
# entity activity (a status change or resolution) can propose a follow-up
# ("Return Watch") candidate. See src/monitoring/return-watch.ts.
RETURN_WATCH_MIN_DAYS_SINCE_PUBLISH=14

# IndexNow — SEO ping after each published post
# Generate a key (e.g. a UUID without dashes) and host it at https://{SITE_URL}/{key}.txt
# Update SITE_URL when a custom domain is purchased — no code changes needed
INDEXNOW_KEY=
SITE_URL=https://sidelineiq.vercel.app

# Salary-derived athlete tiers (see data/significance-config.json salary_tiers).
# Opt-in: when false/unset the salary snapshot is never loaded and every athlete
# missing from data/athlete-tiers.json keeps the flat tier-3 default.
SALARY_TIER_ENABLED=false
# How long a loaded salary snapshot is reused before re-reading (default 6h,
# matching ROSTER_SYNC_INTERVAL_MS — roster sync is the only thing that changes it).
SALARY_SNAPSHOT_TTL_MS=21600000

# Derived athlete tiers for the sports salary cannot reach (see
# data/significance-config.json derived_tiers): PREMIER_LEAGUE takes tier 2 from
# the player's club, UFC takes tier 1/2 from the fighter's best card position.
# Opt-in on the same terms as SALARY_TIER_ENABLED: when false/unset no snapshot
# is loaded and every PL/UFC athlete missing from data/athlete-tiers.json keeps
# the flat tier-3 default, which tier_blocks ALL of their TRACKING.
DERIVED_TIER_ENABLED=false
# How long a loaded derived snapshot is reused before re-reading (default 6h,
# matching roster sync, which is what changes club assignments).
DERIVED_TIER_SNAPSHOT_TTL_MS=21600000
